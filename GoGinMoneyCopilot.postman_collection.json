              ],
              "path": [
                "accounts",
                "{{account_id}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Hesap v2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/accounts/{{account_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "accounts",
                "{{account_id}}"
              ]
            },
            "description": "Hesapta islem varsa 409: FK kisiti (23503) -> ErrAccountInUse."
          },
          "response": []
        },
        {
          "name": "List account transactions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/accounts/{{account_id}}/transactions?page=1&page_size=20",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "accounts",
                "{{account_id}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "20"
                }
              ]
            },
            "description": "Sayfalama: page (varsayilan 1), page_size (varsayilan 20)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const b = pm.response.json();",
                  "    const list = b.transactions || b.data || b;",
                  "    if (Array.isArray(list) && list.length) {",
                  "        pm.collectionVariables.set('transaction_id', list[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
